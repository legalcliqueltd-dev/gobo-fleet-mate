# Build-time values for Vite.
#
# WARNING: every VITE_-prefixed variable is embedded in the JS bundle and is
# therefore PUBLIC — readable by anyone who unzips the APK or views source.
# Only values that are safe to publish belong here. OAuth *client IDs* are
# public by design; a client *SECRET* is not — that goes in the Supabase
# dashboard only, never in this file.

VITE_SUPABASE_PROJECT_ID="invbnyxieoyohahqhbir"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImludmJueXhpZW95b2hhaHFoYmlyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjIyNTAxMDUsImV4cCI6MjA3NzgyNjEwNX0.bOHyM6iexSMj-EtMoyjMEm92ydF5Yy-J7DHgocn4AKI"
VITE_SUPABASE_URL="https://invbnyxieoyohahqhbir.supabase.co"
VITE_GOOGLE_MAPS_API_KEY="AIzaSyAA9FQoMjAHnoFFRKlQ7TTSraI5Y6t-_P8"

# --- Manager portal sign-in (native app) ---

# Google OAuth Web client ID. Used by Supabase's Google provider and as the
# Android `webClientId` the native sign-in sheet exchanges for an ID token.
VITE_GOOGLE_WEB_CLIENT_ID=268918163192-0ojr871ka4iciq6qiron6drmt0sevahs.apps.googleusercontent.com

# Google OAuth iOS client ID (create an "iOS" OAuth client for bundle ID
# app.fleettrackmate.driver, then paste it here).
VITE_GOOGLE_IOS_CLIENT_ID=

# Apple Sign In — LIVE ON iOS (guideline 4.8), hidden on Android and web.
# Native iOS Sign in with Apple comes from the OS and needs neither of the two
# values below; it needs the com.apple.developer.applesignin entitlement, which
# is set in ios/App/App/App.entitlements.
#
# Fill these in only to also offer Apple sign-in on Android/web, which uses the
# browser flow: create an Apple "Services ID" and point its return URL at the
# Supabase callback. Leaving them empty keeps those platforms Google-only.
VITE_APPLE_SERVICE_ID=
VITE_APPLE_REDIRECT_URL=
